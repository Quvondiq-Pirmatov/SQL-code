-- 🔗 JOIN TASKS

--  Tasklar 1-task
-- SELECT customers.name, orders.order_date, orders.total_amount FROM customers JOIN orders ON customers.customer_id = orders.customer_id;

--  Tasklar 2-task
-- SELECT customers.customer_id, customers.name, orders.order_id, orders.order_date, orders.total_amount FROM customers LEFT JOIN orders ON customers.customer_id = orders.customer_id;

--  Tasklar 3-task
-- SELECT o.order_id, o.branch_id, o.total_amount, o.order_date, c.name FROM orders o LEFT JOIN customers c ON c.customer_id = o.customer_id;

--  Tasklar 4-task
SELECT 
	o.order_id, 
	c.name, 
	b.branch_name, 
    o.total_amount 
FROM orders o 
JOIN 
	branches b ON b.branch_id = o.branch_id
JOIN customers c ON c.customer_id = o.customer_id;

-- 5 - task
SELECT  c.name, 
		r.name AS referred_by_name
FROM 
	customers c 
LEFT JOIN   
	customers r ON 	c.referred_by  = r.customer_id;

-- 6 - task
SELECT 
	c.name AS customer_name, 
    SUM(o.total_amount) AS total_orders 
FROM 
	customers c 
JOIN 
	orders o ON c.customer_id = o.customer_id  
GROUP BY 
	c.customer_id, c.name
HAVING
	SUM(o.total_amount) > 500;

-- 7 - task
    SELECT 
	o.order_id, 
    c.name,
    b.branch_name,
    o.total_amount
FROM 
	orders o
JOIN 
	customers c ON o.customer_id = c.customer_id
JOIN 
	branches b ON o.branch_id = b.branch_id

-- 8 - task
SELECT 
	o.order_id,
    b.branch_name,
    o.total_amount
FROM 
	orders o 
JOIN 
	 branches b ON b.branch_id = o.branch_id
WHERE
	b.branch_name = 'Toshkent'
ORDER BY  
	o.total_amount DESC;

-- 9 - task

    SELECT 
	o.order_id,
    o.order_date,    
    r.return_date,
    o.total_amount,
    r.return_amount
FROM 
	orders o  
LEFT JOIN 
	returns r ON o.order_id = r.order_id
WHERE
	MONTH(o.order_date) = 1 AND YEAR(o.order_date) = 2024;

-- 10 - task
SELECT
	b.branch_name,
    COUNT(o.order_id) AS total_orders
FROM
	branches b
JOIN 
	orders o ON b.branch_id = o.branch_id
GROUP BY 
	b.branch_name;

-- 📊 GROUP BY TASKS

-- 11 - task     1. Total number of orders per customer
SELECT 
	c.name,
    COUNT(o.order_id) AS orders_count
FROM 
	customers c 
LEFT JOIN 
	orders o ON c.customer_id = o.customer_id
GROUP BY
	c.name

-- 12 - task
-- 2. Total sales per branch
SELECT 
	b.branch_name,
    SUM(o.total_amount) AS total_sales 
FROM
	branches b
JOIN 
	orders o ON b.branch_id = o.branch_id
GROUP BY 
	b.branch_name

-- 13 - task    3. Average order amount per customer
SELECT 
	c.name,
    AVG(o.total_amount) AS avarage_spent 
FROM
	customers c
LEFT JOIN 
	orders o ON c.customer_id = o.customer_id
GROUP BY 
	c.name

-- 14 - task
SELECT 
	b.branch_name,
    COUNT(o.order_id) AS order_counts 
FROM
	branches b
LEFT JOIN 
	orders o ON b.branch_id = o.branch_id
GROUP BY 
	b.branch_name 
HAVING
	COUNT(o.order_id)> 5;

-- 15 - task
SELECT 
    YEAR(order_date) AS order_year,
    MONTH(order_date) AS order_month,
    COUNT(order_id) AS order_count
FROM 
    orders
GROUP BY 
    YEAR(order_date), MONTH(order_date)
ORDER BY 
    order_year, order_month  ASC ; 


-- 16 - task 6. Total sales per customer per branch
SELECT 
    c.name,
    b.branch_name,
    SUM(o.total_amount)
FROM 
	orders o
JOIN
	branches b ON b.branch_id = o.branch_id
JOIN
	customers c ON c.customer_id = o.customer_id
GROUP BY 
    c.name, b.branch_name

-- 17 - task 7. Min/max order amount per branch
SELECT 	
    b.branch_name,    
    Max(o.total_amount) AS max_order,
    Min(o.total_amount) AS min_order
FROM 
	orders o	
JOIN
	 branches b ON b.branch_id = o.branch_id
GROUP BY 
    b.branch_name


-- 18 - task 8. Total revenue per branch (with JOIN)
SELECT 	
    b.branch_name,    
    SUM(o.total_amount) AS total_revenue    
FROM 
	orders o	
JOIN
	 branches b ON b.branch_id = o.branch_id
GROUP BY 
    b.branch_name


-- 19 - task 9. Daily orders per branch
SELECT 	
    b.branch_name,    
    o.order_date,
    COUNT(o.order_id)AS order_count
FROM 
	orders o	
JOIN
	 branches b ON b.branch_id = o.branch_id
GROUP BY 
    b.branch_name, o.order_date
ORDER BY 
    o.order_date, b.branch_name;

-- 20 - task 10. Count high-value orders (> $1000) per branch using CASE
SELECT 	
    b.branch_name,    
    COUNT(CASE 
          	WHEN o.total_amount > 1000 THEN 1 
          END)AS order_count
FROM 
	orders o	
JOIN
	 branches b ON b.branch_id = o.branch_id
GROUP BY 
    b.branch_name

-- 🔀 UNION TASKS
-- 21 - task  1. Combine customers who placed orders and who made returns
	-- Buyurtma bergan mijozlar
SELECT 
    c.name AS customer_name
FROM 
    customers c
JOIN 
    orders o ON c.customer_id = o.customer_id

UNION

-- Tovar qaytargan mijozlar
SELECT 
    c.name AS customer_name
FROM 
    customers c
JOIN 
    orders o ON c.customer_id = o.customer_id
JOIN 
    returns r ON o.order_id = r.order_id;

-- 22 - task  2. Same as above but include duplicates (UNION ALL)

-- Buyurtma bergan mijozlar
SELECT 
    c.name AS customer_name
FROM 
    customers c
JOIN 
    orders o ON c.customer_id = o.customer_id

UNION ALL

-- Tovar qaytargan mijozlar
SELECT 
    c.name AS customer_name
FROM 
    customers c
JOIN 
    orders o ON c.customer_id = o.customer_id
JOIN 
    returns r ON o.order_id = r.order_id;


-- 23 - task 3. Customers who ordered in 2024 and returned in 2025
SELECT DISTINCT c.name
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id
WHERE YEAR(o.order_date) = 2024
  AND c.customer_id IN (
    SELECT c2.customer_id
    FROM customers c2
    JOIN orders o2 ON c2.customer_id = o2.customer_id
    JOIN returns r ON o2.order_id = r.order_id
    WHERE YEAR(r.return_date) = 2025
);


-- 24 - task   4. Combine "Active" and "Inactive" customers with label
-- Active customers (with orders)
SELECT 
    c.name AS customer_name,
    'Active' AS status
FROM 
    customers c
JOIN 
    orders o ON c.customer_id = o.customer_id

UNION

-- Inactive customers (no orders)
SELECT 
    c.name AS customer_name,
    'Inactive' AS status
FROM 
    customers c
LEFT JOIN 
    orders o ON c.customer_id = o.customer_id
WHERE 
    o.order_id IS NULL;


-- 25 - task 5. Combine and sort all transaction dates (orders + returns)
SELECT 
    order_date AS transaction_date
FROM 
    orders

UNION

SELECT 
    return_date AS transaction_date
FROM 
    returns

ORDER BY 
    transaction_date;
